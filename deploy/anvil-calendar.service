[Unit]
Description=ANVIL Kalender — Google-/ICS-Sync ins 8-Wochen-Fenster (anvil-cal --sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/anvil-brain
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets (ANVIL_GOOGLE_CLIENT_ID/_SECRET, ANVIL_CAL_ICS_URLS — Bearer-URLs!)
# liegen hier, chmod 600. Der Sync ist reines HTTP+SQLite, kein Agent-Lauf.
EnvironmentFile=-%h/.config/anvil/env
ExecStart=%h/anvil-brain/.venv/bin/anvil-cal --sync
