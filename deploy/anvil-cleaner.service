[Unit]
Description=ANVIL daily vault cleaner — garden the vault and propose clutter for deletion
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/anvil-brain
# The agent spawns the `claude` CLI, which lives in ~/.local/bin — not on a
# user service's default PATH, so set it explicitly.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets (ANVIL_BB_PASSWORD, etc.) live here, chmod 600. The leading "-" makes
# the file optional so the unit still loads if it is missing.
EnvironmentFile=-%h/.config/anvil/env
ExecStart=%h/anvil-brain/.venv/bin/anvil-cleaner --run
