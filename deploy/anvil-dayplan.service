[Unit]
Description=ANVIL Tagesplan — Kalender + Training + Kanban → eine abarbeitbare Tagesnotiz
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/anvil-brain
# Der Planer-Agent spawnt die `claude`-CLI aus ~/.local/bin — explizit auf den PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/anvil/env
ExecStart=%h/anvil-brain/.venv/bin/anvil-dayplan --daily
