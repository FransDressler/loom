[Unit]
Description=ANVIL WhatsApp inbox — poll WAHA and capture into the vault
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/anvil-brain
# The agent spawns the `claude` CLI, which lives in ~/.local/bin — not on a
# user service's default PATH, so set it explicitly.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets (ANVIL_WA_API_KEY, etc.) live here, chmod 600. The leading "-" makes
# the file optional so the unit still loads if it is missing.
EnvironmentFile=-%h/.config/anvil/env
ExecStart=%h/anvil-brain/.venv/bin/anvil-whatsapp --poll
