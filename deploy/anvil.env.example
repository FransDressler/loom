# Copy to ~/.config/anvil/env and `chmod 600` it. Read by the systemd timer.
# These are KEY=VALUE lines (no `export`, no quotes needed).

# BlueBubbles server on your Mac. Use the LAN address the Mac is reachable at
# from this machine (or a tunnel URL). Default port is 1234.
ANVIL_BB_URL=http://192.168.1.50:1234
ANVIL_BB_PASSWORD=your-bluebubbles-server-password

# The chat ANVIL watches and replies into. Find it with:
#   anvil-imessage --list-chats
ANVIL_BB_CHAT_GUID=iMessage;-;+49123456789

# Optional:
# ANVIL_BB_REPLY=1                 # send a confirmation back (1=on, 0=off)
# ANVIL_BB_SEND_METHOD=apple-script  # or "private-api" if the helper is installed
# ANVIL_VAULT=/home/frans/ANVIL

# WhatsApp inbox (anvil-whatsapp.timer) via a WAHA relay. WAHA runs the WhatsApp
# HTTP API in Docker, linked to a dedicated WhatsApp account via QR (like
# WhatsApp Web) — no Meta Business account needed. Run WAHA on a separate number
# and message that account from your own phone. Captures anything you send (photos,
# PDFs, voice notes, office files); same OCR/MarkItDown/link handling as iMessage,
# plus a rolling chat history and (optionally) sending files back. Quickstart:
#   docker run -it -p 3000:3000 devlikeapro/waha
#   then open http://localhost:3000 and scan the QR to link the account.
# Only set these if you actually use the WhatsApp inbox; leave them out otherwise.
# ANVIL_WA_URL=http://localhost:3000
# ANVIL_WA_API_KEY=your-waha-api-key   # only if WAHA was started with WHATSAPP_API_KEY
# ANVIL_WA_SESSION=default
# The chat ANVIL watches and replies into (a WhatsApp JID). Find it with:
#   anvil-whatsapp --list-chats
# ANVIL_WA_CHAT_ID=49123456789@c.us
# ANVIL_WA_REPLY=1                 # send a confirmation back (1=on, 0=off)
# ANVIL_WA_FETCH_LIMIT=100         # recent messages pulled per poll
# Outbound media: let the agent send a vault file (image/PDF/audio/doc) BACK into
# the chat when you ask ("schick mir die Skizze aus Notiz X"). Sandboxed to the
# vault; goes via WAHA sendImage/sendFile/sendVoice. On by default.
# ANVIL_WA_SEND_MEDIA=1
# ANVIL_OUTBOX_MAX_MB=16           # hard cap on a single outbound file

# Telegram inbox (anvil-telegram.timer) — the lightest channel: a Bot HTTP API bot,
# no relay or container. Create a bot with @BotFather, paste its token, message the
# bot once, then find your chat id with `anvil-telegram --list-chats`.
# ANVIL_TG_BOT_TOKEN=123456:ABC-your-bot-token
# ANVIL_TG_CHAT_ID=123456789       # your user id, or a group/channel id
# ANVIL_TG_REPLY=1                 # send a confirmation back
# ANVIL_TG_SEND_MEDIA=1            # give the agent send_attachment

# Discord inbox (anvil-discord.timer) — a bot polled over the REST API (no gateway).
# Create a bot in the Discord developer portal, ENABLE the "Message Content Intent",
# invite it to your server, and watch one channel (right-click the channel → Copy ID;
# Developer Mode must be on).
# ANVIL_DISCORD_BOT_TOKEN=your-discord-bot-token
# ANVIL_DISCORD_CHANNEL_ID=123456789012345678
# ANVIL_DISCORD_REPLY=1
# ANVIL_DISCORD_SEND_MEDIA=1

# Voice notes & chat history (both inboxes). WhatsApp voice notes are ogg/opus and
# get transcoded via ffmpeg, then transcribed in this language (vault is German).
# A rolling per-chat history is fed to the agent so a topic can span several messages.
# ANVIL_AUDIO_LANG=de-DE
# ANVIL_CHAT_HISTORY=1             # feed recent conversation as context (1=on, 0=off)
# ANVIL_CHAT_HISTORY_TURNS=16      # how many recent turns to keep/feed back
# ANVIL_CHAT_HISTORY_MAX_CHARS=1500  # cap on characters kept per turn

# Inbox skills: give the chat agent an overview of all ANVIL skills + a queue_skill
# tool so it can enqueue heavy flows (deep research, ingest, schema/glossary/sync)
# for the task worker instead of blocking the chat. On by default.
# ANVIL_INBOX_SKILLS=1

# Code sessions — when the chat agent judges a message to be a CODING task, it hands
# it to a headless `claude -p --dangerously-skip-permissions` run in ANVIL_CODE_DIR
# via the task worker, and posts progress + the git diff back into the chat.
# ⚠️ DANGEROUS: this is remote code execution — a chat message can make Claude Code
# run arbitrary shell commands + edit files in ANVIL_CODE_DIR. OFF by default. Needs
# the task worker (anvil-tasks) running. Only enable if you trust your own chat.
# ANVIL_CODE_SESSIONS=0
# ANVIL_CODE_DIR=/home/frans/myproject   # the repo code sessions run in (full rights)
# ANVIL_CODE_MODEL=claude-opus-4-8       # model for the headless run (optional)
# ANVIL_CODE_TIMEOUT_S=1800              # hard timeout per code run
# ANVIL_CODE_DIFF_MAX_CHARS=1800         # cap on the diff posted to the chat

# Full agent — give the chat agent ITSELF unrestricted permissions: the full Claude
# Code tool set INCLUDING Bash and permission_mode=bypassPermissions, for EVERY
# incoming message (not just classified coding tasks like CODE_SESSIONS above).
# ⚠️ DANGEROUS: this is remote code execution via chat — anyone who can post to a
# watched chat can run any command / read any file on this machine. OFF by default.
# Enable ONLY for a chat that only you can reach (e.g. your own-number WhatsApp group).
# ANVIL_FULL_AGENT=0

# Progress updates: long background jobs (document ingest, queued skills) post short
# one-liners as they move through stages ("📄 3/10 durch Mathpix", "📚 Konzept-Wiki
# wird gebaut", "✅ fertig"). The messaging listeners always report attachment
# progress back into the chat the file came from; this only routes jobs with NO
# inbound chat (the ingest watcher, the task worker) to a channel. One of:
# whatsapp | telegram | discord | imessage | "" (off). Default: whatsapp.
# ANVIL_NOTIFY_CHANNEL=whatsapp

# Document ingest (anvil-ingest.service). A drop folder OUTSIDE the vault you dump
# documents into; a worker files each settled file into the vault via the deep-
# research pipeline (the files ARE the sources — no web), keeps the scanned Mathpix
# Markdown in raw/, embeds figures, then moves the original to <dump>/.processed/.
# ANVIL_INGEST_DIR=~/anvil-dump      # the drop folder (created on first --watch)
# ANVIL_INGEST_FOLDER=Eingang        # vault cluster the sources accumulate in
# ANVIL_INGEST_POLL_INTERVAL=10      # seconds between drop-folder checks
# ANVIL_INGEST_SETTLE_SECONDS=5      # wait until a file stops changing (mid-copy guard)
# ANVIL_INGEST_BATCH=10              # max files processed per cycle
# ANVIL_INGEST_INTEGRATE=1           # also build the concept/wiki layer (0 = raw+source notes only)
# A .zip (sent to a chat OR dropped here) is UNPACKED — each file inside is filed on
# its own. These caps stop a zip bomb from filling the disk:
# ANVIL_INGEST_ZIP_MAX_MEMBERS=300   # max files extracted from one archive
# ANVIL_INGEST_ZIP_MAX_TOTAL_MB=500  # max total uncompressed size per archive

# Skill task queue (anvil-tasks.service). The chat agent queues heavy flows here;
# this worker runs them down off-thread.
# ANVIL_TASK_QUEUE_DIR=agent-tasks   # vault folder for the queue (todo/working/done)
# ANVIL_TASK_POLL_INTERVAL=10        # seconds between queue checks
# ANVIL_TASK_BATCH=1                 # tasks run per cycle (each can be very heavy)

# Mathpix OCR — when set, image and PDF attachments you text in are run through
# Mathpix and the recognised Markdown is captured into the vault. Get the
# credentials at https://mathpix.com (Convert API). Leave empty to ignore docs.
# ANVIL_MATHPIX_APP_ID=your-mathpix-app-id
# ANVIL_MATHPIX_APP_KEY=your-mathpix-app-key
# ANVIL_MATHPIX_PDF_TIMEOUT=180    # seconds to wait for an async PDF conversion
# ANVIL_DOC_ASSET_DIR=attachments  # vault folder where originals are stored + embedded

# Figures inside a PDF come back as image links. When on (default), each figure
# is downloaded into the vault and captioned by a cheap Claude (Haiku) pass.
# ANVIL_DESCRIBE_IMAGES=1
# ANVIL_DESCRIBE_MODEL=claude-haiku-4-5-20251001
# ANVIL_DESCRIBE_MAX_IMAGES=20     # cap on figures captioned per document

# MarkItDown (Microsoft) — handles the things you just send in: voice notes &
# audio are transcribed (via ffmpeg + speech recognition), EPub and office/text
# files (docx, pptx, xlsx, csv, html, json, …) are read, and a plain http(s) link
# you text in is fetched (YouTube as transcript, web pages as article) and filed
# instead of saved as a bare URL. On by default; audio needs ffmpeg.
# ANVIL_MARKITDOWN=1                 # master switch (voice/audio/EPub/office files)
# ANVIL_MARKITDOWN_URLS=1            # also expand texted-in links (0 = keep raw)
# ANVIL_MARKITDOWN_MAX_CHARS=80000   # cap on converted text fed to the agent

# Research / build mode (`anvil research "<topic>"`). A capable model is
# recommended; figure captions still use the cheap DESCRIBE_MODEL above.
# ANVIL_RESEARCH_MODEL=claude-opus-4-8
# ANVIL_RESEARCH_MAX_TURNS=80
# ANVIL_RESEARCH_MAX_PDFS=10
#
# Deep mode (`anvil research --deep "<topic>"`): a planner discovers many
# sources, a fan-out writes one note per source, then synthesis builds the Hub.
# Heavier + token-intensive. Tune depth/parallelism here.
# ANVIL_RESEARCH_DEEP_MIN_SOURCES=50   # target number of sources
# ANVIL_RESEARCH_DEEP_MAX_SOURCES=80   # hard cap
# ANVIL_RESEARCH_DEEP_CONCURRENCY=4    # source sub-agents running at once

# Web chat (anvil-web.service). A browser front-end to the same agent. Reach it
# from anywhere through a private tunnel rather than opening a router port:
#   Tailscale:  tailscale serve --bg 8765        # gives an HTTPS url on your tailnet
#   Cloudflare: cloudflared tunnel --url http://127.0.0.1:8765
# Both connect to 127.0.0.1, so leave ANVIL_WEB_HOST at the default.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANVIL_WEB_TOKEN=replace-with-a-long-random-token
# ANVIL_WEB_HOST=127.0.0.1
# ANVIL_WEB_PORT=8765

# Daily cleaner (anvil-cleaner.timer). Gardens the vault and proposes clutter
# for deletion via iMessage; nothing is removed until you reply. All on by default.
# ANVIL_CLEANER_TIDY=1             # run the gardening agent (links/frontmatter/networking)
# ANVIL_CLEANER_TIDY_MAX_TURNS=40
# ANVIL_CLEANER_EMPTY=1            # propose empty / near-empty notes
# ANVIL_CLEANER_ORPHANS=1          # propose unreferenced attachments
# ANVIL_CLEANER_DUPLICATES=1       # propose duplicate notes
# ANVIL_CLEANER_OLD_CONVERSATIONS=1
# ANVIL_CLEANER_CONV_MAX_AGE_DAYS=30
# ANVIL_CLEANER_MIN_CHARS=15
# ANVIL_CLEANER_MAX_CANDIDATES=30
# ANVIL_CLEANER_USE_TRASH=1        # 0 = delete permanently instead of moving to .trash
# ANVIL_CLEANER_PENDING_TTL_H=48   # how long a proposal stays answerable
