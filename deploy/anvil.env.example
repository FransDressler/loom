# Copy to ~/.config/anvil/env and `chmod 600` it. Read by the systemd timer.
# These are KEY=VALUE lines (no `export`, no quotes needed).

# BlueBubbles server on your Mac. Use the LAN address the Mac is reachable at
# from this machine (or a tunnel URL). Default port is 1234.
ANVIL_BB_URL=http://192.168.1.50:1234
ANVIL_BB_PASSWORD=your-bluebubbles-server-password

# The chat ANVIL watches and replies into. Find it with:
#   anvil-imessage --list-chats
ANVIL_BB_CHAT_GUID=iMessage;-;+49123456789

# Optional:
# ANVIL_BB_REPLY=1                 # send a confirmation back (1=on, 0=off)
# ANVIL_BB_SEND_METHOD=apple-script  # or "private-api" if the helper is installed
# ANVIL_VAULT=/home/frans/ANVIL

# Mathpix OCR — when set, image and PDF attachments you text in are run through
# Mathpix and the recognised Markdown is captured into the vault. Get the
# credentials at https://mathpix.com (Convert API). Leave empty to ignore docs.
# ANVIL_MATHPIX_APP_ID=your-mathpix-app-id
# ANVIL_MATHPIX_APP_KEY=your-mathpix-app-key
# ANVIL_MATHPIX_PDF_TIMEOUT=180    # seconds to wait for an async PDF conversion
# ANVIL_DOC_ASSET_DIR=attachments  # vault folder where originals are stored + embedded

# Figures inside a PDF come back as image links. When on (default), each figure
# is downloaded into the vault and captioned by a cheap Claude (Haiku) pass.
# ANVIL_DESCRIBE_IMAGES=1
# ANVIL_DESCRIBE_MODEL=claude-haiku-4-5-20251001
# ANVIL_DESCRIBE_MAX_IMAGES=20     # cap on figures captioned per document

# Web chat (anvil-web.service). A browser front-end to the same agent. Reach it
# from anywhere through a private tunnel rather than opening a router port:
#   Tailscale:  tailscale serve --bg 8765        # gives an HTTPS url on your tailnet
#   Cloudflare: cloudflared tunnel --url http://127.0.0.1:8765
# Both connect to 127.0.0.1, so leave ANVIL_WEB_HOST at the default.
# Generate a token: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANVIL_WEB_TOKEN=replace-with-a-long-random-token
# ANVIL_WEB_HOST=127.0.0.1
# ANVIL_WEB_PORT=8765

# Daily cleaner (anvil-cleaner.timer). Gardens the vault and proposes clutter
# for deletion via iMessage; nothing is removed until you reply. All on by default.
# ANVIL_CLEANER_TIDY=1             # run the gardening agent (links/frontmatter/networking)
# ANVIL_CLEANER_TIDY_MAX_TURNS=40
# ANVIL_CLEANER_EMPTY=1            # propose empty / near-empty notes
# ANVIL_CLEANER_ORPHANS=1          # propose unreferenced attachments
# ANVIL_CLEANER_DUPLICATES=1       # propose duplicate notes
# ANVIL_CLEANER_OLD_CONVERSATIONS=1
# ANVIL_CLEANER_CONV_MAX_AGE_DAYS=30
# ANVIL_CLEANER_MIN_CHARS=15
# ANVIL_CLEANER_MAX_CANDIDATES=30
# ANVIL_CLEANER_USE_TRASH=1        # 0 = delete permanently instead of moving to .trash
# ANVIL_CLEANER_PENDING_TTL_H=48   # how long a proposal stays answerable
