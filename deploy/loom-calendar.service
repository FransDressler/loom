[Unit]
Description=Loom Kalender — Google-/ICS-Sync ins 8-Wochen-Fenster (loom-cal --sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/loom
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets (LOOM_GOOGLE_CLIENT_ID/_SECRET, LOOM_CAL_ICS_URLS — Bearer-URLs!)
# liegen hier, chmod 600. Der Sync ist reines HTTP+SQLite, kein Agent-Lauf.
EnvironmentFile=-%h/.config/loom/env
ExecStart=%h/loom/.venv/bin/loom-cal --sync
