[Unit]
Description=Loom fitness alle 30 min tagsüber (Plan morgens, Analysen nach Workouts)

[Timer]
# Every 30 minutes between 05:00 and 22:30 local time. The job is idempotent: it
# syncs, writes the day's plan exactly once (waiting for the morning Oura data
# until the fallback hour), and analyzes newly finished workouts. No Persistent:
# the next slot is at most 30 minutes away.
OnCalendar=*-*-* 05..22:00,30:00
AccuracySec=2min

[Install]
WantedBy=timers.target
