[Unit]
Description=Loom document-ingest watcher — file dumped documents into the vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/loom
# The agent spawns the `claude` CLI, which lives in ~/.local/bin — not on a
# user service's default PATH, so set it explicitly.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Secrets and LOOM_* settings live here, chmod 600. The leading "-" makes the
# file optional so the unit still loads if it is missing.
EnvironmentFile=-%h/.config/loom/env
# --watch checks the drop folder (LOOM_INGEST_DIR, default ~/loom-dump) every
# LOOM_INGEST_POLL_INTERVAL seconds (default 10) and files new documents.
ExecStart=%h/loom/.venv/bin/loom-ingest --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
