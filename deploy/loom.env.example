# Copy to ~/.config/loom/env and `chmod 600` it. Loaded by the systemd units
# (EnvironmentFile=) AND by loom itself at import (CLI + MCP server); real env
# vars / systemd always win. Disable the self-load with LOOM_NO_ENV_FILE=1.
# These are KEY=VALUE lines (no `export`, no quotes needed).

# BlueBubbles server on your Mac. Use the LAN address the Mac is reachable at
# from this machine (or a tunnel URL). Default port is 1234.
LOOM_BB_URL=http://192.168.1.50:1234
LOOM_BB_PASSWORD=your-bluebubbles-server-password

# The chat Loom watches and replies into. Find it with:
#   loom-imessage --list-chats
LOOM_BB_CHAT_GUID=iMessage;-;+49123456789

# Optional:
# LOOM_BB_REPLY=1                 # send a confirmation back (1=on, 0=off)
# LOOM_BB_SEND_METHOD=apple-script  # or "private-api" if the helper is installed
# LOOM_VAULT=/home/frans/Loom

# WhatsApp inbox (loom-whatsapp.timer) via a WAHA relay. WAHA runs the WhatsApp
# HTTP API in Docker, linked to a dedicated WhatsApp account via QR (like
# WhatsApp Web) — no Meta Business account needed. Run WAHA on a separate number
# and message that account from your own phone. Captures anything you send (photos,
# PDFs, voice notes, office files); same OCR/MarkItDown/link handling as iMessage,
# plus a rolling chat history and (optionally) sending files back. Quickstart:
#   docker run -it -p 3000:3000 devlikeapro/waha
#   then open http://localhost:3000 and scan the QR to link the account.
# Only set these if you actually use the WhatsApp inbox; leave them out otherwise.
# LOOM_WA_URL=http://localhost:3000
# LOOM_WA_API_KEY=your-waha-api-key   # only if WAHA was started with WHATSAPP_API_KEY
# LOOM_WA_SESSION=default
# The chat Loom watches and replies into (a WhatsApp JID). Find it with:
#   loom-whatsapp --list-chats
# LOOM_WA_CHAT_ID=49123456789@c.us
# LOOM_WA_REPLY=1                 # send a confirmation back (1=on, 0=off)
# LOOM_WA_FETCH_LIMIT=100         # recent messages pulled per poll
# Outbound media: let the agent send a vault file (image/PDF/audio/doc) BACK into
# the chat when you ask ("schick mir die Skizze aus Notiz X"). Sandboxed to the
# vault; goes via WAHA sendImage/sendFile/sendVoice. On by default.
# LOOM_WA_SEND_MEDIA=1
# LOOM_OUTBOX_MAX_MB=16           # hard cap on a single outbound file

# Telegram inbox (loom-telegram.timer) — the lightest channel: a Bot HTTP API bot,
# no relay or container. Create a bot with @BotFather, paste its token, message the
# bot once, then find your chat id with `loom-telegram --list-chats`.
# LOOM_TG_BOT_TOKEN=123456:ABC-your-bot-token
# LOOM_TG_CHAT_ID=123456789       # your user id, or a group/channel id
# LOOM_TG_REPLY=1                 # send a confirmation back
# LOOM_TG_SEND_MEDIA=1            # give the agent send_attachment

# Discord inbox (loom-discord.timer) — a bot polled over the REST API (no gateway).
# Create a bot in the Discord developer portal, ENABLE the "Message Content Intent",
# invite it to your server, and watch one channel (right-click the channel → Copy ID;
# Developer Mode must be on).
# LOOM_DISCORD_BOT_TOKEN=your-discord-bot-token
# LOOM_DISCORD_CHANNEL_ID=123456789012345678
# LOOM_DISCORD_REPLY=1
# LOOM_DISCORD_SEND_MEDIA=1

# Voice notes & chat history (both inboxes). WhatsApp voice notes are ogg/opus and
# get transcoded via ffmpeg, then transcribed in this language (vault is German).
# A rolling per-chat history is fed to the agent so a topic can span several messages.
# LOOM_AUDIO_LANG=de-DE
# LOOM_CHAT_HISTORY=1             # feed recent conversation as context (1=on, 0=off)
# LOOM_CHAT_HISTORY_TURNS=16      # how many recent turns to keep/feed back
# LOOM_CHAT_HISTORY_MAX_CHARS=1500  # cap on characters kept per turn

# Inbox skills: give the chat agent an overview of all Loom skills + a queue_skill
# tool so it can enqueue heavy flows (deep research, ingest, schema/glossary/sync)
# for the task worker instead of blocking the chat. On by default.
# LOOM_INBOX_SKILLS=1

# Geplante Prompts (loom-jobs): der Chat-Agent darf einmalige/wiederkehrende Prompts
# planen ("erinnere mich morgen 9:00 an X") — schedule_job-Tool auf allen Kanälen
# außer Discord (untrusted). Tick läuft im loom-tasks-Worker; Zustellung in den
# Ursprungs-Chat, [SILENT]-Antwort wird nicht zugestellt. Default AUS.
# `loom doctor` prüft diese Datei übrigens mit (Rechte 600, Shell-Drift).
# LOOM_JOBS=1
# LOOM_JOBS_MODEL=                # leer = Chat-Modell (LOOM_MODEL)
# LOOM_JOBS_MAX_TURNS=15         # Turn-Deckel pro Job-Lauf
# LOOM_JOBS_MAX_JOBS=50          # Guard gegen LLM-Schleifen, die Jobs anlegen

# Kalender (loom-cal): Google Kalender lesen (+ schreiben ab Phase 2) und
# iCloud-Kalender read-only via öffentliche ICS-Feeds. Setup: docs/calendar.md —
# WICHTIG: GCP-Consent-Screen ERST auf "In production" publishen, DANN
# `loom-cal --auth google` (sonst 7-Tage-Refresh-Token-Falle). Default AUS.
# LOOM_CALENDAR=1
# LOOM_GOOGLE_CLIENT_ID=
# LOOM_GOOGLE_CLIENT_SECRET=
# LOOM_CAL_GOOGLE_IDS=primary     # kommasepariert; IDs via `loom-cal --calendars`
# LOOM_CAL_ICS_URLS=              # name=https://…/cal.ics,… (URL = Geheimnis!)
# LOOM_CAL_EXAM_CALENDAR=         # Kalendername mit Klausuren (sonst Titel-Muster)
# LOOM_CAL_POLL_MIN=15
# LOOM_CAL_DAY_START=8            # Wachfenster für freie Blöcke
# LOOM_CAL_DAY_END=22

# Code sessions — when the chat agent judges a message to be a CODING task, it hands
# it to a headless `claude -p --dangerously-skip-permissions` run in LOOM_CODE_DIR
# via the task worker, and posts progress + the git diff back into the chat.
# ⚠️ DANGEROUS: this is remote code execution — a chat message can make Claude Code
# run arbitrary shell commands + edit files in LOOM_CODE_DIR. OFF by default. Needs
# the task worker (loom-tasks) running. Only enable if you trust your own chat.
# LOOM_CODE_SESSIONS=0
# LOOM_CODE_DIR=/home/frans/myproject   # the repo code sessions run in (full rights)
# LOOM_CODE_MODEL=claude-opus-4-8       # model for the headless run (optional)
# LOOM_CODE_TIMEOUT_S=1800              # hard timeout per code run
# LOOM_CODE_DIFF_MAX_CHARS=1800         # cap on the diff posted to the chat

# Full agent — give the chat agent ITSELF unrestricted permissions: the full Claude
# Code tool set INCLUDING Bash and permission_mode=bypassPermissions, for EVERY
# incoming message (not just classified coding tasks like CODE_SESSIONS above).
# ⚠️ DANGEROUS: this is remote code execution via chat — anyone who can post to a
# watched chat can run any command / read any file on this machine. OFF by default.
# Enable ONLY for a chat that only you can reach (e.g. your own-number WhatsApp group).
# LOOM_FULL_AGENT=0

# Progress updates: long background jobs (document ingest, queued skills) post short
# one-liners as they move through stages ("📄 3/10 durch Mathpix", "📚 Konzept-Wiki
# wird gebaut", "✅ fertig"). The messaging listeners always report attachment
# progress back into the chat the file came from; this only routes jobs with NO
# inbound chat (the ingest watcher, the task worker) to a channel. One of:
# whatsapp | telegram | discord | imessage | "" (off). Default: whatsapp.
# LOOM_NOTIFY_CHANNEL=whatsapp

# Document ingest (loom-ingest.service). A drop folder OUTSIDE the vault you dump
# documents into; a worker files each settled file into the vault via the deep-
# research pipeline (the files ARE the sources — no web), keeps the scanned Mathpix
# Markdown in raw/, embeds figures, then moves the original to <dump>/.processed/.
# LOOM_INGEST_DIR=~/loom-dump      # the drop folder (created on first --watch)
# LOOM_INGEST_FOLDER=Eingang        # vault cluster the sources accumulate in
# LOOM_INGEST_POLL_INTERVAL=10      # seconds between drop-folder checks
# LOOM_INGEST_SETTLE_SECONDS=5      # wait until a file stops changing (mid-copy guard)
# LOOM_INGEST_BATCH=10              # max files processed per cycle
# LOOM_INGEST_INTEGRATE=1           # also build the concept/wiki layer (0 = raw+source notes only)
# A .zip (sent to a chat OR dropped here) is UNPACKED — each file inside is filed on
# its own. These caps stop a zip bomb from filling the disk:
# LOOM_INGEST_ZIP_MAX_MEMBERS=300   # max files extracted from one archive
# LOOM_INGEST_ZIP_MAX_TOTAL_MB=500  # max total uncompressed size per archive

# Feynman learning mode (loom-feynman.service). Drop voice recordings explaining
# a subject into the watch folder; an examiner agent loaded with the subject's
# vault cluster corrects you, asks one follow-up per round and writes a chat-format
# session protocol into the vault. Local Whisper transcription needs the optional
# extra: uv sync --extra feynman.
# LOOM_FEYNMAN_DIR=~/loom-feynman     # recordings watch folder (created on first --watch)
# LOOM_FEYNMAN_SUBJECT=                # default subject (vault cluster folder, e.g. AQC)
# LOOM_FEYNMAN_SESSION_FOLDER=lernsessions  # vault folder for the session protocols
# LOOM_FEYNMAN_SESSION_GAP_H=8         # recordings closer than this continue the session
# LOOM_FEYNMAN_POLL_INTERVAL=5         # seconds between folder checks
# LOOM_FEYNMAN_USE_WHISPER=1           # 0 = always use the markitdown/Google fallback
# LOOM_FEYNMAN_WHISPER_MODEL=medium    # tiny|base|small|medium|large-v3 (quality vs. speed)
# LOOM_FEYNMAN_LANG=de                 # spoken language of the recordings
# LOOM_FEYNMAN_MODEL=                  # examiner model (empty = account default)

# Skill task queue (loom-tasks.service). The chat agent queues heavy flows here;
# this worker runs them down off-thread.
# LOOM_TASK_QUEUE_DIR=agent-tasks   # vault folder for the queue (todo/working/done)
# LOOM_TASK_POLL_INTERVAL=10        # seconds between queue checks
# LOOM_TASK_BATCH=1                 # tasks run per cycle (each can be very heavy)

# Fitness (loom-fitness.timer): Oura ring + Strava → Tagestrainingsplan + Analysen.
# One-time setup:
#   1. Strava-API-App anlegen: https://www.strava.com/settings/api (Callback-Domain:
#      localhost). ACHTUNG: seit Juni 2026 braucht der Standard-Tier-API-Zugang ein
#      bezahltes Strava-Abo.
#   2. Oura-OAuth2-App anlegen: https://developer.ouraring.com (Personal Access
#      Tokens gibt es seit Dez 2025 nicht mehr); Redirect-URI:
#      http://localhost:8723/callback
#   3. Credentials hier eintragen, dann einmalig autorisieren:
#      loom-fitness --auth strava && loom-fitness --auth oura
#   4. deploy/loom-start.sh ausführen — der Timer startet nur, wenn --check passt.
# LOOM_STRAVA_CLIENT_ID=12345
# LOOM_STRAVA_CLIENT_SECRET=your-strava-client-secret
# LOOM_OURA_CLIENT_ID=your-oura-client-id
# LOOM_OURA_CLIENT_SECRET=your-oura-client-secret
# LOOM_FITNESS_GOALS=                 # Freitext-Ziele für den Coach ("Marathon im Oktober, 2x Kraft/Woche")
# LOOM_FITNESS_LTHR=0                 # Laktatschwellen-HF für hrTSS (0 = unbekannt → suffer_score-Proxy)
# LOOM_FITNESS_FTP=0                  # FTP in Watt für Power-TSS (0 = unbekannt)
# LOOM_FITNESS_PROGRESSION_PCT=5.0    # Aufschlag auf das beste e1RM → Lastvorschlag (bewusst progressiv)
# LOOM_FITNESS_E1RM_WINDOW_D=120      # Fenster für »beste Serie« der 1RM-Schätzung, in Tagen
# LOOM_FITNESS_LIFT_RIR_TARGET=2.0    # Ziel-RIR, auf das die Lastvorschläge gerechnet werden
# LOOM_FITNESS_DIR=fitness            # Vault-Ordner für Pläne/Analysen/Wissen
# LOOM_FITNESS_PLAN_FROM_H=5          # frühestens ab dieser Stunde planen
# LOOM_FITNESS_PLAN_FALLBACK_H=10     # ab dann auch ohne frische Oura-Daten planen
# LOOM_FITNESS_ANALYZE=1              # Workout-Analysen nach dem Sync (0 = aus)
# LOOM_FITNESS_CHANNEL=               # Push-Kanal (leer = LOOM_NOTIFY_CHANNEL, "off" = kein Push)
# LOOM_FITNESS_MODEL=                 # Coach-Modell (leer = Research-/Account-Default)
# LOOM_STRAVA_BACKFILL_DAYS=365       # wie weit der erste Sync zurückreicht
# LOOM_STRAVA_WITH_STREAMS=1          # HR/Watt-Zeitreihen mitladen (0 = nur Summary/Detail)

# Spotify (loom-mcp: /loom:music): abspielen, Playlists, DJ-Emulation + Musik-Präferenzen.
# One-time setup:
#   1. OAuth2-App anlegen: https://developer.spotify.com/dashboard
#   2. Redirect-URI EXAKT so eintragen (Spotify verbietet »localhost«, Loopback-IP Pflicht):
#      http://127.0.0.1:8888/callback
#   3. ACHTUNG (Feb 2026): Playback UND der Dev-Mode selbst brauchen Spotify Premium;
#      den eigenen Account in der App unter "User Management" freischalten (max. 5 Nutzer).
#   4. Credentials hier eintragen, dann einmalig autorisieren:
#      loom-spotify --auth
#   5. Spotify-App (Desktop/Handy) offen halten = aktives Gerät fürs Abspielen.
# LOOM_SPOTIFY_CLIENT_ID=your-spotify-client-id
# LOOM_SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# LOOM_SPOTIFY_OAUTH_PORT=8888        # Port der Loopback-Redirect-URI (127.0.0.1:<port>/callback)
# LOOM_SPOTIFY_MARKET=                 # ISO-Land für Suche/Playback-Relinking (leer = aus dem Account)
# LOOM_MUSIC_DIR=musik                 # Vault-Ordner für Geschmacks-Notizen (Profil + Lieblingssongs)

# Mathpix OCR — when set, image and PDF attachments you text in are run through
# Mathpix and the recognised Markdown is captured into the vault. Get the
# credentials at https://mathpix.com (Convert API). Leave empty to ignore docs.
# LOOM_MATHPIX_APP_ID=your-mathpix-app-id
# LOOM_MATHPIX_APP_KEY=your-mathpix-app-key
# LOOM_MATHPIX_PDF_TIMEOUT=180    # seconds to wait for an async PDF conversion
# LOOM_DOC_ASSET_DIR=attachments  # vault folder where originals are stored + embedded

# Figures inside a PDF come back as image links. When on (default), each figure
# is downloaded into the vault and captioned by a cheap Claude (Haiku) pass.
# LOOM_DESCRIBE_IMAGES=1
# LOOM_DESCRIBE_MODEL=claude-haiku-4-5-20251001
# LOOM_DESCRIBE_MAX_IMAGES=20     # cap on figures captioned per document

# MarkItDown (Microsoft) — handles the things you just send in: voice notes &
# audio are transcribed (via ffmpeg + speech recognition), EPub and office/text
# files (docx, pptx, xlsx, csv, html, json, …) are read, and a plain http(s) link
# you text in is fetched (YouTube as transcript, web pages as article) and filed
# instead of saved as a bare URL. On by default; audio needs ffmpeg.
# LOOM_MARKITDOWN=1                 # master switch (voice/audio/EPub/office files)
# LOOM_MARKITDOWN_URLS=1            # also expand texted-in links (0 = keep raw)
# LOOM_MARKITDOWN_MAX_CHARS=80000   # cap on converted text fed to the agent

# Research / build mode (`loom research "<topic>"`). A capable model is
# recommended; figure captions still use the cheap DESCRIBE_MODEL above.
# LOOM_RESEARCH_MODEL=claude-opus-4-8
# LOOM_RESEARCH_MAX_TURNS=80
# LOOM_RESEARCH_MAX_PDFS=10
#
# Deep mode (`loom research --deep "<topic>"`): a planner discovers many
# sources, a fan-out writes one note per source, then synthesis builds the Hub.
# Heavier + token-intensive. Tune depth/parallelism here.
# LOOM_RESEARCH_DEEP_MIN_SOURCES=50   # target number of sources
# LOOM_RESEARCH_DEEP_MAX_SOURCES=80   # hard cap
# LOOM_RESEARCH_DEEP_CONCURRENCY=4    # source sub-agents running at once

# Daily cleaner (loom-cleaner.timer). Gardens the vault and proposes clutter
# for deletion via iMessage; nothing is removed until you reply. All on by default.
# LOOM_CLEANER_TIDY=1             # run the gardening agent (links/frontmatter/networking)
# LOOM_CLEANER_TIDY_MAX_TURNS=40
# LOOM_CLEANER_EMPTY=1            # propose empty / near-empty notes
# LOOM_CLEANER_ORPHANS=1          # propose unreferenced attachments
# LOOM_CLEANER_DUPLICATES=1       # propose duplicate notes
# LOOM_CLEANER_OLD_CONVERSATIONS=1
# LOOM_CLEANER_CONV_MAX_AGE_DAYS=30
# LOOM_CLEANER_MIN_CHARS=15
# LOOM_CLEANER_MAX_CANDIDATES=30
# LOOM_CLEANER_USE_TRASH=1        # 0 = delete permanently instead of moving to .trash
# LOOM_CLEANER_PENDING_TTL_H=48   # how long a proposal stays answerable

# Dynamisches Context-Management. Der Vault ist das Langzeitgedächtnis, Sessions
# sind wegwerfbare Arbeitsfenster. Drei unabhängige Bausteine, alle DEFAULT AUS —
# in dieser Reihenfolge scharf schalten:
#
# 1) Memory-Flächen: »Loom — Profil & Präferenzen« + »Loom — Aktuelle Projekte«
#    werden (gecappt, je ~3000 Zeichen) in JEDEN Agenten-Prompt injiziert. Erst die
#    Notizen von Hand befüllen und ein paar Tage nutzen, dann einschalten.
# LOOM_MEMORY_NOTES=1
#
# 2) Kontext-Hinweis pro Turn: deterministischer UserPromptSubmit-Hook (kein LLM,
#    <1s, fail-open) — injiziert das letzte retrieve-Thema + passende Notiz-Titel
#    als Wegweiser. Hook ist im Vault registriert (.claude/settings.json) und tut
#    ohne dieses Flag nichts.
# LOOM_CONTEXT_HINT=1
# LOOM_CONTEXT_HINT_MAX_NOTES=5
#
# 3) Schlaf-Konsolidierung (läuft im Cleaner-Timer mit): destilliert Chat-Verläufe
#    in Episoden (conversations/<jahr>/) + die Memory-Flächen, BEVOR Beiträge aus
#    dem rollierenden 16er-Fenster fallen. Zusammenfassen kann ein günstigeres
#    Modell; Session + retrieve bleiben auf dem starken.
# LOOM_CLEANER_CONSOLIDATE=1
# LOOM_CONSOLIDATE_MODEL=claude-sonnet-4-6
# LOOM_CONSOLIDATE_MAX_TURNS=30
#    Erste Woche: Dry-Run an lassen (Agent schreibt NUR einen Bericht nach
#    ops/reports/ statt Notizen zu ändern). Berichte prüfen, dann auf 0.
# LOOM_CONSOLIDATE_DRY_RUN=1
#    Retention (nur bei scharfem Lauf): destillierte, >N Tage inaktive Chat-Fenster
#    wandern in den STATE-Trash (~/.local/state/loom/trash/), nie hart gelöscht.
#    0 = aus.
# LOOM_CHAT_RETENTION_DAYS=0

# Kalender schreiben (Phase 2): Lernblöcke in den dedizierten Google-Kalender
# "Loom Lernplan" — IMMER über die Bestätigungs-Queue, nie in fremde Termine.
# LOOM_CALENDAR_WRITE=1
# LOOM_CAL_WRITE_ID=              # ID des Loom-Lernplan-Kalenders

# Kanban: Aufgaben als Vault-Notizen (ops/tasks/), Chat-Tools
# task_add/task_list/task_move. Default AUS.
# LOOM_KANBAN=1

# Tagesplan (loom-dayplan.timer): morgens EINE abarbeitbare Tagesnotiz aus
# Kalender + Trainingsplan + Kanban-Top-Tasks + Budgets, mit Push-Kurzfassung.
# Wartet auf den Trainingsplan des Tages, plant ab FALLBACK_H auch ohne ihn.
# LOOM_DAYPLAN=1
# LOOM_DAYPLAN_FALLBACK_H=9
# LOOM_DAYPLAN_CHANNEL=           # leer = LOOM_NOTIFY_CHANNEL, "off" = kein Push
# LOOM_CAL_HIWI_CALENDAR=         # Kalendername der HiWi-Schichten (sonst Titel-Muster "hiwi")
